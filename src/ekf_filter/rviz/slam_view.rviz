Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: map
      Enabled: true

    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Topic: /map
      Enabled: true
      Color Scheme: map
      Alpha: 0.7

    - Class: rviz_default_plugins/Path
      Name: Robot Path
      Topic: /robot_path
      Enabled: true
      Color: 25; 255; 0
      Alpha: 1.0
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz_default_plugins/LaserScan
      Name: Laser Scan
      Topic: /scan
      Enabled: true
      Size (m): 0.05
      Color: 255; 255; 255
      Alpha: 1.0

    - Class: rviz_default_plugins/Axes
      Name: Robot Pose
      Enabled: true
      Reference Frame: base_link
      Length: 0.5
      Radius: 0.05

  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Name: Orbit View
      Pitch: 1.57
      Yaw: 0.0
